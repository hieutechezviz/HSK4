{
  "rules": {
    "stats": {
      ".read": true,
      "months": {
        "$month": {
          ".write": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)",
          ".validate": "$month.matches(/^20[0-9]{2}-[01][0-9]$/)"
        }
      }
    },
    "presence": {
      ".read": true,
      "$id": {
        ".write": "(!data.exists() && newData.val() === true) || (data.exists() && !newData.exists())",
        ".validate": "$id.length <= 30"
      }
    }
  }
}
